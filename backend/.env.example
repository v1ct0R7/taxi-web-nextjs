PORT=4000

# MySQL — vendos të dhënat e tua këtu
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taxi_db
DB_USER=root
DB_PASSWORD=

# true vetëm në zhvillim: përshtat tabelat me modelet (ALTER)
DB_SYNC_ALTER=false

JWT_SECRET=replace-with-a-long-random-secret

# Administratori i parë (krijohet nga `npm run seed`)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@tiranaride.al
ADMIN_PASSWORD=change-me-now

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
